# ---- how MigrationGuard talks to a model -------------------------------------
# claude_cli    : shell out to the `claude` CLI (uses your Claude Code login, no API key)
# anthropic_api : direct API calls, needs ANTHROPIC_API_KEY
# replay        : cassettes only - deterministic, free, no network (default for judges)
# stub          : no model at all, for CI smoke tests
MG_LLM_PROVIDER=replay
MG_MODEL=claude-sonnet-4-5
MG_TEMPERATURE=0
MG_RECORD=1

# ANTHROPIC_API_KEY=sk-ant-...        # only for MG_LLM_PROVIDER=anthropic_api

# ---- shadow database (the sandbox migrations are executed in) ----------------
# Must be a throwaway cluster. MigrationGuard creates and drops databases on it.
MG_SHADOW_DSN=postgresql://mg:mg@127.0.0.1:5433/postgres
MG_SHADOW_ENABLED=1
MG_SEED_ROWS=20000
MG_STATEMENT_TIMEOUT_MS=30000

# ---- agent behaviour (ablation switches used by the improvement changelog) ---
MG_MAX_TOOL_ITERS=6
MG_ENABLE_VERIFIER=1
MG_ENABLE_REWRITER=1

# ---- the human approval gate -------------------------------------------------
# `mg approve` refuses any DSN that is not listed here. Never put production in it.
MG_SANDBOX_DSNS=postgresql://mg:mg@127.0.0.1:5433/postgres
